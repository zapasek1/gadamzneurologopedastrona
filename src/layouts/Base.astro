---
import '@fontsource/gilda-display/latin-400.css';
import '@fontsource/gilda-display/latin-ext-400.css';
import '@fontsource-variable/jost';
import '../styles/global.css';
import ustawienia from '../content/ustawienia.json';
import cookies from '../content/cookies.json';
import { asset, href } from '../lib/util';

interface Props {
  title?: string;
  description?: string;
}
const { title, description } = Astro.props;
const pageTitle = title ?? `${ustawienia.imie_nazwisko} — ${ustawienia.tytul}`;
const desc = description ?? ustawienia.seo_opis;
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:image" content={new URL(asset('og-image.jpg'), Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#f2ece7" />
    <link rel="icon" href={asset('favicon-32.png')} sizes="32x32" type="image/png" />
    <link rel="icon" href={asset('favicon-64.png')} sizes="64x64" type="image/png" />
    <link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#tresc">Przejdź do treści</a>
    <slot />

    <section
      id="cookie-banner"
      class="consent"
      role="dialog"
      aria-modal="false"
      aria-labelledby="consent-title"
      aria-describedby="consent-text"
      hidden
    >
      <div class="consent__inner">
        <div class="consent__text">
          <h2 id="consent-title" class="consent__title">Pliki cookies</h2>
          <p id="consent-text">
            {cookies.tekst}{' '}<a href={href('polityka-prywatnosci/')}>Polityka prywatności</a>
          </p>
        </div>
        <div class="consent__actions">
          <button type="button" class="btn btn--solid" data-consent="all">Akceptuję</button>
          <button type="button" class="btn" data-consent="necessary">Tylko niezbędne</button>
        </div>
      </div>
    </section>

    <script>
      import { initConsentBanner } from '../scripts/consent';
      initConsentBanner();
    </script>
  </body>
</html>
